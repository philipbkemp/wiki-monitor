{
    "compilerOptions": {
        "esModuleInterop": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "types": ["node","@playwright/test"]
    },
    "include": [
        "monitoring/**/*.ts",
        "playwright.config.ts"
    ]
}